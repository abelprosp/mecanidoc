# Copiar para .env na raiz do projeto (não fazer commit do .env).
# Gerar segredos com:  openssl rand -hex 32

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose)
# ---------------------------------------------------------------------------
# Superutilizador — só init/migrações/scripts de import. A app NÃO usa este utilizador.
POSTGRES_USER=mecanidoc
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mecanidoc
# Password do papel mecanidoc_app (utilizador da aplicação, sem privilégios; RLS aplica-se).
MECANIDOC_APP_DB_PASSWORD=change-me-another-strong-password

# Scripts no host (npm run seed:*, import:*): superutilizador + porta publicada.
# docker compose up                       → Postgres no host em 5434
# docker compose -f docker-compose.dev.yml up → porta 5433
DATABASE_URL=postgresql://mecanidoc_app:change-me-another-strong-password@localhost:5433/mecanidoc
# Para scripts de import/seed no host use o superutilizador:
# DATABASE_URL=postgresql://mecanidoc:change-me-strong-password@localhost:5433/mecanidoc
DB_ADMIN_ROLE=mecanidoc_admin

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
AUTH_SECRET=change-me-use-openssl-rand-hex-32
CRON_SECRET=change-me-use-openssl-rand-hex-32
# npm run dev usa a porta 3002 (scripts/run-next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Em produção a app deve estar atrás de HTTPS. Só definir 1 se for servida em HTTP puro.
ALLOW_INSECURE_COOKIES=0

# ---------------------------------------------------------------------------
# Stripe (teste). Em alternativa: Admin → Paiement Stripe.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# E-mail transacional (recuperação de password). Se vazio, usa SMTP do suporte (Admin).
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="MecaniDoc <no-reply@mecanidoc.com>"

# ---------------------------------------------------------------------------
# Neumáticos Andrés (opcional; também configurável no Admin)
# ---------------------------------------------------------------------------
# NEUMATICOS_ANDRES_LOGIN=
# NEUMATICOS_ANDRES_PASSWORD=
# NEUMATICOS_ANDRES_BASE_URL=https://backend.genasa.es
# NEUMATICOS_ANDRES_TEST_MODE=1
