# Copiar para .env na raiz do projeto (não fazer commit do .env).
#
# Scripts no host (npm run seed:*, import:*, etc.): use localhost + porta publicada.
# docker compose up → Postgres no host em 5434 (interno Docker: 5432)
# docker compose -f docker-compose.dev.yml up → porta 5433
DATABASE_URL=postgresql://mecanidoc:mecanidoc@localhost:5434/mecanidoc
#
# Dentro do contentor app (docker-compose.yml) o serviço usa hostname "postgres"
# automaticamente — não copie isso para o .env do host.
#
AUTH_SECRET=change-me-use-openssl-rand-hex-32
# npm run dev usa a porta 3002 (scripts/run-next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Stripe (teste). Em alternativa: Admin → Paiement Stripe.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

